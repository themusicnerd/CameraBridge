[Unit]
Description=CameraBridge independent camera service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/camerabridge
ExecStart=/usr/bin/python3 -m backend.server --config %h/.config/camerabridge/config.json --storage %h/.local/share/camerabridge
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/camerabridge
UMask=0077
MemoryMax=256M
CPUQuota=25%

[Install]
WantedBy=default.target

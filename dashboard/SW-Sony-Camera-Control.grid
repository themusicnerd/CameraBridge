        <label name="FOCUS MODE" left="16" top="8" width="548" height="26" style="fg#e2e4e9;size:16;txt-align:west;" />
        <button name="−" left="16" top="39" width="64" height="48" buttontype="push" style="bg#494f5b;fg#ffffff;bdr:none;size:16;">
          <task tasktype="ogscript">adjust('focus_auto',-1,1,2);</task>
        </button>

          <param oid="sony_number_value" left="16" top="84" width="428" height="64" showlabel="false" widget="3" style="size:26;txt-align:center;w.keyboard:disabled;" />
          <button name="7" left="16" top="202" width="102" height="58" buttontype="push" style="bg#494f5b;fg#ffffff;bdr:none;size:16;">

<?xml version='1.0' encoding='utf-8'?>
<abs contexttype="opengear" id="_top" name="CameraBridge" virtualwidth="1366" virtualheight="872" width="1366" height="872" gridaspect="false" style="bg#25282e;fg#e2e4e9;size:16;">
  <api>
var CB_Panasonic=(function(nativeParams,nativeScript){
    var prefix="panasonic_",active=false;
    var params={getValue:function(k,i){return nativeParams.getValue(k=='bridge'?'bridge':prefix+k,i);},
      setValue:function(k,i,v){nativeParams.setValue(prefix+k,i,v);},setAccess:function(k,v){nativeParams.setAccess(prefix+k,v);},
      getParam:function(k,i){return nativeParams.getParam(prefix+k,i);},
      replaceConstraint:function(k,id){nativeParams.replaceConstraint(prefix+k,prefix+id);}};
    var ogscript={reveal:function(k){nativeScript.reveal(prefix+k);},hide:function(k){nativeScript.hide(prefix+k);},rename:function(k,v){nativeScript.rename(prefix+k,v);},setStyle:function(k,v){nativeScript.setStyle(prefix+k,v);},
      asyncPost:function(u,d,c){nativeScript.asyncPost(u,d,c);},
      setXML:function(k,xml){nativeScript.setXML(prefix+k,String(xml).replace(/\bid="([^"]+)"/g,'id="'+prefix+'$1"'));}};
    var CB_MANUFACTURER = 'Panasonic';

var cbToken = '';
var cbUpdating = false;
var cbPending = {};
var cbEdit = {};
var cbCameras = [];
var cbIndex = 0;
var cbEpoch = 0;
var cbBusy = false;
var cbTick = 0;
var cbLastFeedback = 0;
var cbHandover = false;
var cbTouchEnabled = false;
var cbNoticeUntil = 0;
var cbConstraints = {};
var cbRanges = {};
var cbGainStep=1;
var cbCapabilities = {};
var cbWritable={},cbAllowed={},cbNumberEditor=null;
var cbNumberFields={},cbRangeFields={};
var cbPresetSpeeds = {};
var cbMotionFlight=false, cbMotionIntent=null, cbMotionHeld=null, cbMotionLast=0, cbMotionStop=false, cbMotionFull=false;
function status(text) {
    if(String(text).indexOf('Feedback refreshed')==0 &amp;&amp; new Date().getTime()&lt;cbNoticeUntil)return;
    ogscript.rename('status', text);
}
function highlightPage(name) {
    var pages=CB_MANUFACTURER=='Sony'?['Lens','Paint','Tally','Config']:CB_MANUFACTURER=='Panasonic'?['PTZ','Presets','Paint','Config']:['Paint','Image','Exposure','OSD','Config'];
    for(var i=0;i&lt;pages.length;i++)ogscript.setStyle('nav_'+pages[i].toLowerCase(),'bg#'+(pages[i]==name?'7433bd':'494f5b')+';fg#ffffff;bdr:none;');
}
function request(path, data, callback) {
    data.token = cbToken;
    var base = String(params.getValue('bridge', 0));
    ogscript.asyncPost(base + '/api/' + path, 'request=' + encodeURIComponent(JSON.stringify(data)), function(raw) {
        try {
            var result = JSON.parse(String(raw));
            if(!result){if(path!='state')status('No Command Reply; Check Feedback');if(callback)callback(null);return;}
            if (result.error) { status(result.error); if (callback) callback(null); return; }
            if (callback) callback(result);
        } catch (e) { cbNoticeUntil=new Date().getTime()+10000;status('Panel Error: '+String(e)); if (callback) callback(null); }
    });
}
function login() {
    var data = {username:String(params.getValue('username',0)),password:String(params.getValue('password',0))};
    params.setValue('password',0,'');
    request('login', data, function(r) { if(r) {cbToken = r.token; status('Authenticated ' + r.role); poll();} });
}
var cbLinkUrl = '';
function refreshBridgeLink() {
    var url=String(params.getValue('bridge',0)).replace(/\/+$/,'')+'/';
    if(url==cbLinkUrl)return;
    var valid=/^https?:\/\/[A-Za-z0-9.\-:\[\]]+\/$/.test(url);
    var html=valid?'&lt;html&gt;&lt;p&gt;Select this link to open setup:&lt;/p&gt;&lt;a href="'+url+'"&gt;&lt;font size="5" color="#80d9eb"&gt;'+url+'&lt;/font&gt;&lt;/a&gt;&lt;p&gt;Sign in in the browser to control cameras.&lt;/p&gt;&lt;/html&gt;':'&lt;html&gt;Set a valid HTTP or HTTPS backend URL on Config.&lt;/html&gt;';
    ogscript.setXML('bridge_launcher','&lt;help id="open_bridge" left="0" top="0" width="180" height="56" name="Open setup" title="CameraBridge setup" popupwidth="600" popupheight="180" style="bg#49a8d8;fg#ffffff;size:16;"&gt;&lt;![CDATA['+html+']]&gt;&lt;/help&gt;');
    cbLinkUrl=url;
}

function numberFormat(key,value) {
    return value===null || value===undefined?'Unknown':String(value);
}
function numberRefresh(key) {
    if(cbNumberFields[key])ogscript.rename('number_entry_'+key,numberFormat(key,params.getValue(key,0)));
}
function numberBounds(key) {
    if(key=='speed')return [1,49];
    if(key=='recall_speed')return [1,30];
    if(key=='shot_number')return [1,cbCapabilities.preset_max===undefined?100:cbCapabilities.preset_max];
    return cbRanges[key];
}
function numberEditable(key) {
    return !!cbToken &amp;&amp; !cbHandover &amp;&amp; ((key=='speed'||key=='recall_speed'||key=='shot_number') || cbWritable[key]===true);
}
function numberOpen(key) {
    if(!numberEditable(key)){status('This Value Is Read Only');return;}
    var bounds=numberBounds(key);if(!bounds){status('Wait For Camera Range Feedback');return;}
    if(key=='recall_speed' &amp;&amp; cbCapabilities.preset_speed===false){status('Recall Speed Is Unavailable For This Camera');return;}
    if(cbMotionHeld)release();
    cbNumberEditor={key:key,camera:selected(),epoch:cbEpoch,replace:true};
    params.setValue('number_value',0,String(params.getValue(key,0)));
    params.setValue('number_title',0,key.replace(/_/g,' ').toUpperCase());
    params.setValue('number_limits',0,'Range '+bounds[0]+' to '+bounds[1]+(cbAllowed[key]&amp;&amp;cbAllowed[key].length?' | Values '+cbAllowed[key].join(', '):''));
    params.setValue('number_error',0,'');ogscript.reveal('number_popup');
}
function numberDigit(digit) {
    if(!cbNumberEditor)return;
    var old=cbNumberEditor.replace?'':String(params.getValue('number_value',0));cbNumberEditor.replace=false;
    if(old.length&lt;18)params.setValue('number_value',0,old+digit);
}
function numberDelete() {
    if(!cbNumberEditor)return;cbNumberEditor.replace=false;
    params.setValue('number_value',0,String(params.getValue('number_value',0)).slice(0,-1));
}
function numberSign() {
    if(!cbNumberEditor)return;cbNumberEditor.replace=false;
    var text=String(params.getValue('number_value',0));params.setValue('number_value',0,text.charAt(0)=='-'?text.substring(1):'-'+text);
}
function numberCancel() {cbNumberEditor=null;ogscript.hide('number_popup');}
function numberApply() {
    var editor=cbNumberEditor;if(!editor)return;
    if(editor.camera!=selected() || editor.epoch!=cbEpoch || !numberEditable(editor.key)){numberCancel();status('Camera Changed; Value Not Applied');return;}
    var text=String(params.getValue('number_value',0)),bounds=numberBounds(editor.key),value=Number(text);
    if(!/^-?[0-9]+$/.test(text) || !isFinite(value) || Math.floor(value)!=value || value&lt;bounds[0] || value&gt;bounds[1]){params.setValue('number_error',0,'Enter An Integer From '+bounds[0]+' To '+bounds[1]);return;}
    if(cbAllowed[editor.key]&amp;&amp;cbAllowed[editor.key].length&amp;&amp;cbAllowed[editor.key].indexOf(value)&lt;0){params.setValue('number_error',0,'Select A Listed Value');return;}
    if((editor.key=='red_gain'||editor.key=='blue_gain') &amp;&amp; value%cbGainStep){params.setValue('number_error',0,'Use Steps Of '+cbGainStep);return;}
    params.setValue(editor.key,0,CB_MANUFACTURER=='Sony'&amp;&amp;(editor.key=='shutter'||editor.key=='zoom')?String(value):value);
    numberRefresh(editor.key);numberCancel();
}

function selected() { return String(params.getValue('camera',0)); }
function send(action, data, callback) {
    if (!cbToken) { status('Sign in to control cameras.'); return; }
    if (cbHandover &amp;&amp; action!='stop') { status('Camera handover: waiting for previous stop'); return; }
    request('command',{camera:selected(),action:action,data:data || {}},callback);
}
function nextCamera() {
    if(cbCameras.length)cameraAt((cbIndex+1)%cbCameras.length);
}
function cameraAt(index) {
    if(index&gt;=cbCameras.length || cbHandover)return;
    var old=selected(),target=cbCameras[index].id;
    if(old==target)return;
    cbEpoch++;cbPending={};cbEdit={};cbMotionHeld=null;cbMotionIntent=null;cbHandover=true;
    var finish=function(r){
        cbHandover=false;
        if(!r){status('Handover stopped: previous camera stop not confirmed');return;}
        cbIndex=index;params.setAccess('camera',1);params.setValue('camera',0,target);params.setAccess('camera',0);poll();
    };
    if(cbToken)request('command',{camera:old,action:'stop',data:{}},finish);
    else finish({readOnly:true});
}
function touchEnable() {
    if(!cbToken){status('Sign in on the Config page first');return;}
    cbTouchEnabled=!cbTouchEnabled;
    ogscript.rename('touch_enable',cbTouchEnabled?'Touch control ENABLED':'Touch control DISABLED');
    if(!cbTouchEnabled)stop();
}
function pumpMotion() {
    if(cbMotionFlight || cbHandover)return;
    if(cbMotionStop) {
        cbMotionStop=false;var full=cbMotionFull;cbMotionFull=false;cbMotionFlight=true;
        request('command',{camera:selected(),action:'stop',data:{active_only:!full}},function(r){
            cbMotionFlight=false;
            if(!r){cbMotionIntent=null;cbMotionHeld=null;cbTouchEnabled=false;ogscript.rename('touch_enable','Touch control DISABLED');status('Stop failed; movement remains disabled');return;}
            pumpMotion();
        });return;
    }
    var intent=cbMotionIntent;if(!intent)return;cbMotionIntent=null;cbMotionFlight=true;
    request('command',{camera:intent.camera,action:'claim',data:{}},function(r){
        if(!r || intent.epoch!=cbEpoch || intent.camera!=selected() || cbMotionStop || cbMotionIntent){cbMotionFlight=false;pumpMotion();return;}
        var d=intent.axes;d.generation=r.generation;
        request('command',{camera:intent.camera,action:'move',data:d},function(result){
            cbMotionFlight=false;if(!result)cbMotionIntent=null;pumpMotion();
        });
    });
}
function release() {
    if(!cbToken)return;
    cbEpoch++;cbMotionIntent=null;cbMotionHeld=null;cbMotionStop=true;pumpMotion();
}
function stop() {
    if(!cbToken)return;
    cbEpoch++;cbPending={};cbMotionIntent=null;cbMotionHeld=null;cbMotionStop=true;cbMotionFull=true;pumpMotion();
}
function jog(pan,tilt,zoom,focus) {
    if(!cbTouchEnabled){status('Enable touch control before jogging');return;}
    if(!cbToken)return;
    var speed=Number(params.getValue('speed',0));
    cbMotionLast=new Date().getTime();
    cbMotionIntent={camera:selected(),epoch:cbEpoch,axes:{pan:pan*speed,tilt:tilt*speed,zoom:zoom*speed,focus:focus*speed}};
    cbMotionHeld=cbMotionIntent;pumpMotion();
}
function whiteBalance(mode) {
    if(mode==9 &amp;&amp; (!cbAllowed.wb_mode || cbAllowed.wb_mode.indexOf(9)&lt;0)){status('VAR White Balance Is Unavailable On This Camera');return;}
    if(cbCapabilities.pan_tilt_type=='digital' &amp;&amp; (mode==2 || mode==3))mode--;
    send('write',{parameter:'wb_mode',value:mode},function(r){if(r)poll();});
}
function oneShot() {
    send('white_balance_once',{},function(r){if(r){status('One Shot Sent; completion is not reported');poll();}});
}
function renamePreset() {
    var d={number:Number(params.getValue('shot_number',0)),name:String(params.getValue('shot_name',0))};
    if(cbCapabilities.preset_speed)d.speed=Number(params.getValue('recall_speed',0));
    send('label_preset',d,function(r){if(r)poll();});
}
function changed(key) {
    numberRefresh(key);
    if(cbUpdating)return;
    if(!cbToken){status('Sign in before adjustment');return;}
    var value=Number(params.getValue(key,0));
    if(key=='red_gain'||key=='blue_gain')value=Math.round(value/cbGainStep)*cbGainStep;
    cbPending[key]=value; cbEdit[key]=new Date().getTime();
}
function adjust(key,delta,low,high) {
    if(!cbToken){status('Sign in before adjustment');return;}
    if(cbRanges[key]){low=cbRanges[key][0];high=cbRanges[key][1];}
    var value=Number(params.getValue(key,0));
    if(key=='red_gain'||key=='blue_gain')delta*=cbGainStep;
    params.setValue(key,0,Math.max(low,Math.min(high,value+delta)));
}
function preset(number) {
    if(cbCapabilities.preset_max!==undefined &amp;&amp; number&gt;cbCapabilities.preset_max){status('Shot unavailable for this camera model');return;}
    var store=Number(params.getValue('store',0))==1;
    if(store &amp;&amp; String(params.getValue('confirmation',0))!='OVERWRITE') {status('Type OVERWRITE to store; then select preset');return;}
    var d={number:number,store:store,confirm:String(params.getValue('confirmation',0))};
    if(cbCapabilities.preset_speed &amp;&amp; (store || Number(params.getValue('use_saved_speed',0))==0))d.speed=Number(params.getValue('recall_speed',0));
    send('preset',d,function(r){if(r){status(r.status);poll();}});
    params.setValue('store',0,0);params.setValue('confirmation',0,'');
}
function poll() {
    refreshBridgeLink();
    if(cbBusy)return; cbBusy=true;
    var camera=selected(),epoch=cbEpoch;
    request('state',{},function(r){
        cbBusy=false; if(!r || epoch!=cbEpoch || camera!=selected())return;
        cbLastFeedback=new Date().getTime();cbCameras=[];
        for(var i=0;i&lt;r.cameras.length;i++)if(r.cameras[i].manufacturer==CB_MANUFACTURER)cbCameras.push(r.cameras[i]);
        var c=null;for(var i=0;i&lt;cbCameras.length;i++)if(cbCameras[i].id==camera){c=cbCameras[i];cbIndex=i;}
        if(!c &amp;&amp; cbCameras.length){c=cbCameras[0];cbIndex=0;cbEpoch++;cbPending={};cbTouchEnabled=false;params.setAccess('camera',1);params.setValue('camera',0,c.id);params.setAccess('camera',0);if(CB_MANUFACTURER!='Marshall')ogscript.rename('touch_enable','Touch control DISABLED');}
        if(!c){status('No enabled '+CB_MANUFACTURER+' cameras; add one in CameraBridge setup');return;}
        ogscript.rename('identity',c.name+' | '+c.model+' | input '+c.carbonite_input);
        var endpoint=((r.ross||{}).endpoints||{})[c.id]||{};
        ogscript.rename('connection','CAM '+c.number+' | '+c.health+' | '+(c.host || c.gateway || '')+' | '+(c.locked?'LOCKED':'Available')+(c.pivotcam?' | TCP '+(endpoint.port||'?')+' '+(endpoint.connected?'Connected':'Waiting')+' | Frames '+(endpoint.packets||0)+(endpoint.last_control?' | Last Control '+Math.round(r.time-endpoint.last_control)+'s Ago':' | No Control Received'):''));
        for(var n=0;n&lt;6;n++) {
            var caption=n&lt;cbCameras.length?String(cbCameras[n].name).split(' - ')[0]:'';
            ogscript.rename('camera_pick_'+n,n&lt;cbCameras.length?'CAM '+(cbCameras[n].number || (n+1))+'\n'+caption.slice(0,12):'-');
            ogscript.setStyle('camera_pick_'+n,'bg#'+(n==cbIndex?'7433bd':'494f5b')+';fg#ffffff;bdr:none;size:15;');
        }
        ogscript.setStyle('connection','fg#'+(c.health=='online'||c.health=='simulated'?'8dca95':'d7bb8c')+';size:12;txt-align:west;');
        cbCapabilities=c.capabilities||{};cbGainStep=cbCapabilities.gain_display_divisor||1;
        if(CB_MANUFACTURER=='Panasonic') {
            cbPresetSpeeds=c.preset_speeds||{};
            ogscript.rename('shot_number_label','Shot Number (1 to '+(cbCapabilities.preset_max||100)+') / Name');
            ogscript.rename('paint_help','ATW follows the scene. A / B hold white balance. VAR enables Kelvin entry; the camera uses its nearest supported value.');
            if(c.white_balance_once)ogscript.rename('awb_result','One Shot: '+c.white_balance_once.status+(c.white_balance_once.error?' | '+c.white_balance_once.error:' | completion not reported'));
            var active=c.active_preset||{};
            ogscript.rename('preset_feedback',active.number?'Shot '+active.number+' | Speed '+(active.speed||'Camera Default')+' | '+active.state:'No Shot Recalled');
            for(var n=1;n&lt;=20;n++)ogscript.rename('shot_'+n,('0'+n).slice(-2)+'\n'+((c.preset_names||{})[String(n)] || 'Shot '+n)+(cbPresetSpeeds[String(n)]?' | S'+cbPresetSpeeds[String(n)]:''));
        }
        cbUpdating=true;
        var tally=c.tally||{};
        if(CB_MANUFACTURER!='Marshall')ogscript.rename('tally_state','Tally: '+(tally.enabled?'enabled':'disabled')+' | '+(tally.status||'unknown')+(tally.error?' | '+tally.error:''));
        try {
            for(var key in c.parameters) {
                var p=c.parameters[key];cbRanges[key]=[p.low,p.high];cbAllowed[key]=p.allowed||[];
                if(cbRangeFields[key])ogscript.rename('range_'+key,'Range '+p.low+' to '+p.high);
                try {
                if(CB_MANUFACTURER=='Panasonic' &amp;&amp; (key=='red_gain'||key=='blue_gain') &amp;&amp; cbConstraints[key]!=(cbCapabilities.gain_constraint||'gain_range_'+cbGainStep)){var gainRange=cbCapabilities.gain_constraint||'gain_range_'+cbGainStep;params.replaceConstraint(key,gainRange);cbConstraints[key]=gainRange;}
                if((CB_MANUFACTURER=='Sony' &amp;&amp; key!='shutter' &amp;&amp; key!='zoom' &amp;&amp; p.supported || CB_MANUFACTURER=='Panasonic' &amp;&amp; key=='detail') &amp;&amp; p.low&lt;=p.high) {
                    var range=String(p.low)+';'+String(p.high)+';';
                    if(cbConstraints[key]!=range){params.setAccess(key,1);if(CB_MANUFACTURER=='Panasonic')params.replaceConstraint(key,'detail_range_'+p.high);else params.getParam(key,0).replaceConstraint(String(range));cbConstraints[key]=range;}
                }
                var value=p.value===null?'unknown':String(CB_MANUFACTURER=='Panasonic' &amp;&amp; (key=='red_gain'||key=='blue_gain')?(p.value-150)/(p.display_divisor||1)*(p.display_multiplier||1):p.value);
                if(CB_MANUFACTURER=='Panasonic' &amp;&amp; key=='wb_mode'){var wbNames=cbCapabilities.pan_tilt_type=='digital'?{0:'Auto ATW',1:'Manual A',2:'Manual B',3:'Auto ATW',4:'3200K',5:'5600K'}:{0:'Auto ATW',2:'Manual A',3:'Manual B',4:'3200K',5:'5600K',9:'Variable'};value=wbNames[p.value]||value;}
                ogscript.rename('actual_'+key,value+' | '+p.confirmation+' | '+(p.age_seconds===null?'never read':Math.round(p.age_seconds)+'s'));
                if(p.confirmation=='confirmed' &amp;&amp; !cbPending.hasOwnProperty(key) &amp;&amp; (!cbEdit[key] || new Date().getTime()-cbEdit[key]&gt;1000)) {
                    // DashBoard blocks local setValue while the parameter is read-only.
                    params.setAccess(key,1);params.setValue(key,0,CB_MANUFACTURER=='Sony' &amp;&amp; (key=='shutter'||key=='zoom')?String(p.value):p.value);
                }
                var enabled=!!cbToken &amp;&amp; !c.locked &amp;&amp; (p.confirmation=='confirmed'||p.readback===false&amp;&amp;p.supported&amp;&amp;c.health=='online') &amp;&amp; p.writable!==false;
                if(p.dependency){var pair=p.dependency.split('=');var m=c.parameters[pair[0]];enabled=enabled &amp;&amp; m &amp;&amp; m.confirmation=='confirmed' &amp;&amp; (','+pair[1]+',').indexOf(','+m.value+',')&gt;=0;}
                if(CB_MANUFACTURER=='Marshall' &amp;&amp; (key=='red_gain'||key=='blue_gain'))enabled=enabled &amp;&amp; c.parameters.wb_mode.value==1;
                cbWritable[key]=!!enabled;params.setAccess(key,enabled?1:0);numberRefresh(key);
                } catch(panelError) { cbNoticeUntil=new Date().getTime()+10000;status('Panel '+key+': '+String(panelError)); }
            }
        } finally {cbUpdating=false;}
        for(var localKey in cbNumberFields)if(!c.parameters[localKey])numberRefresh(localKey);
        status('Feedback refreshed | '+(cbToken?'control authenticated':'read-only; sign in to control'));
    });
}
function tick() {
    cbTick++;
    if(cbMotionHeld &amp;&amp; !cbMotionFlight &amp;&amp; !cbHandover &amp;&amp; new Date().getTime()-cbMotionLast&gt;=300){cbMotionIntent=cbMotionHeld;cbMotionLast=new Date().getTime();pumpMotion();}
    if(cbToken)for(var key in cbPending){var value=cbPending[key];delete cbPending[key];send('write',{parameter:key,value:value,snap:CB_MANUFACTURER=='Sony'},null);break;}
    if(cbTick%5==0)poll();
    if(cbLastFeedback &amp;&amp; new Date().getTime()-cbLastFeedback&gt;4000)status('STALE - no bridge feedback for '+Math.round((new Date().getTime()-cbLastFeedback)/1000)+'s');
}

cbNumberFields={"speed": true, "iris": true, "zoom": true, "focus": true, "recall_speed": true, "shot_number": true, "red_gain": true, "blue_gain": true, "detail": true, "colour_temperature": true};cbRangeFields={"iris": true, "zoom": true, "focus": true, "red_gain": true, "blue_gain": true, "detail": true, "colour_temperature": true};
    var originalPoll=poll;
    poll=function(){
      if(active&amp;&amp;U.config){for(var i=0;i&lt;U.config.cameras.length;i++)if(U.config.cameras[i].id==selected()){
        U.index=i;uRoster();var c=U.config.cameras[i];uStatus('Controlling CAM '+c.number+' / '+c.name);break;}}
      originalPoll();
    };
    var originalCameraAt=cameraAt;
    cameraAt=function(index){cbTouchEnabled=false;if(CB_MANUFACTURER!='Marshall')ogscript.rename('touch_enable','Touch control DISABLED');originalCameraAt(index);};
    var originalSend=send;
    send=function(action,data,callback){if(!active&amp;&amp;action!='stop'){status('Select this camera from Cameras / Setup.');return;}originalSend(action,data,callback);};
    return {run:function(code,source){return function(){return eval(code);}.call(source);},
      enter:function(token,cid){cbToken=token;cbTouchEnabled=false;cbEpoch++;cbPending={};cbEdit={};cbConstraints={};active=true;
        params.setAccess('camera',1);params.setValue('camera',0,cid);params.setAccess('camera',0);
        if(CB_MANUFACTURER!='Marshall')ogscript.rename('touch_enable','Touch control DISABLED');poll();},
      leave:function(callback){cbEpoch++;cbPending={};cbEdit={};cbTouchEnabled=false;active=false;
        if(!cbToken){callback(true);return;}request('command',{camera:selected(),action:'stop',data:{}},function(r){if(r){cbToken='';callback(true);}else callback(false);});}};
})(params,ogscript);


var CB_Marshall=(function(nativeParams,nativeScript){
    var prefix="marshall_",active=false;
    var params={getValue:function(k,i){return nativeParams.getValue(k=='bridge'?'bridge':prefix+k,i);},
      setValue:function(k,i,v){nativeParams.setValue(prefix+k,i,v);},setAccess:function(k,v){nativeParams.setAccess(prefix+k,v);},
      getParam:function(k,i){return nativeParams.getParam(prefix+k,i);},
      replaceConstraint:function(k,id){nativeParams.replaceConstraint(prefix+k,prefix+id);}};
    var ogscript={reveal:function(k){nativeScript.reveal(prefix+k);},hide:function(k){nativeScript.hide(prefix+k);},rename:function(k,v){nativeScript.rename(prefix+k,v);},setStyle:function(k,v){nativeScript.setStyle(prefix+k,v);},
      asyncPost:function(u,d,c){nativeScript.asyncPost(u,d,c);},
      setXML:function(k,xml){nativeScript.setXML(prefix+k,String(xml).replace(/\bid="([^"]+)"/g,'id="'+prefix+'$1"'));}};
    var CB_MANUFACTURER = 'Marshall';

var cbToken = '';
var cbUpdating = false;
var cbPending = {};
var cbEdit = {};
var cbCameras = [];
var cbIndex = 0;
var cbEpoch = 0;
var cbBusy = false;
var cbTick = 0;
var cbLastFeedback = 0;
var cbHandover = false;
var cbTouchEnabled = false;
var cbNoticeUntil = 0;
var cbConstraints = {};
var cbRanges = {};
var cbGainStep=1;
var cbCapabilities = {};
var cbWritable={},cbAllowed={},cbNumberEditor=null;
var cbNumberFields={},cbRangeFields={};
var cbPresetSpeeds = {};
var cbMotionFlight=false, cbMotionIntent=null, cbMotionHeld=null, cbMotionLast=0, cbMotionStop=false, cbMotionFull=false;
function status(text) {
    if(String(text).indexOf('Feedback refreshed')==0 &amp;&amp; new Date().getTime()&lt;cbNoticeUntil)return;
    ogscript.rename('status', text);
}
function highlightPage(name) {
    var pages=CB_MANUFACTURER=='Sony'?['Lens','Paint','Tally','Config']:CB_MANUFACTURER=='Panasonic'?['PTZ','Presets','Paint','Config']:['Paint','Image','Exposure','OSD','Config'];
    for(var i=0;i&lt;pages.length;i++)ogscript.setStyle('nav_'+pages[i].toLowerCase(),'bg#'+(pages[i]==name?'7433bd':'494f5b')+';fg#ffffff;bdr:none;');
}
function request(path, data, callback) {
    data.token = cbToken;
    var base = String(params.getValue('bridge', 0));
    ogscript.asyncPost(base + '/api/' + path, 'request=' + encodeURIComponent(JSON.stringify(data)), function(raw) {
        try {
            var result = JSON.parse(String(raw));
            if(!result){if(path!='state')status('No Command Reply; Check Feedback');if(callback)callback(null);return;}
            if (result.error) { status(result.error); if (callback) callback(null); return; }
            if (callback) callback(result);
        } catch (e) { cbNoticeUntil=new Date().getTime()+10000;status('Panel Error: '+String(e)); if (callback) callback(null); }
    });
}
function login() {
    var data = {username:String(params.getValue('username',0)),password:String(params.getValue('password',0))};
    params.setValue('password',0,'');
    request('login', data, function(r) { if(r) {cbToken = r.token; status('Authenticated ' + r.role); poll();} });
}
var cbLinkUrl = '';
function refreshBridgeLink() {
    var url=String(params.getValue('bridge',0)).replace(/\/+$/,'')+'/';
    if(url==cbLinkUrl)return;
    var valid=/^https?:\/\/[A-Za-z0-9.\-:\[\]]+\/$/.test(url);
    var html=valid?'&lt;html&gt;&lt;p&gt;Select this link to open setup:&lt;/p&gt;&lt;a href="'+url+'"&gt;&lt;font size="5" color="#80d9eb"&gt;'+url+'&lt;/font&gt;&lt;/a&gt;&lt;p&gt;Sign in in the browser to control cameras.&lt;/p&gt;&lt;/html&gt;':'&lt;html&gt;Set a valid HTTP or HTTPS backend URL on Config.&lt;/html&gt;';
    ogscript.setXML('bridge_launcher','&lt;help id="open_bridge" left="0" top="0" width="180" height="56" name="Open setup" title="CameraBridge setup" popupwidth="600" popupheight="180" style="bg#49a8d8;fg#ffffff;size:16;"&gt;&lt;![CDATA['+html+']]&gt;&lt;/help&gt;');
    cbLinkUrl=url;
}

function numberFormat(key,value) {
    return value===null || value===undefined?'Unknown':String(value);
}
function numberRefresh(key) {
    if(cbNumberFields[key])ogscript.rename('number_entry_'+key,numberFormat(key,params.getValue(key,0)));
}
function numberBounds(key) {
    if(key=='speed')return [1,49];
    if(key=='recall_speed')return [1,30];
    if(key=='shot_number')return [1,cbCapabilities.preset_max===undefined?100:cbCapabilities.preset_max];
    return cbRanges[key];
}
function numberEditable(key) {
    return !!cbToken &amp;&amp; !cbHandover &amp;&amp; ((key=='speed'||key=='recall_speed'||key=='shot_number') || cbWritable[key]===true);
}
function numberOpen(key) {
    if(!numberEditable(key)){status('This Value Is Read Only');return;}
    var bounds=numberBounds(key);if(!bounds){status('Wait For Camera Range Feedback');return;}
    if(key=='recall_speed' &amp;&amp; cbCapabilities.preset_speed===false){status('Recall Speed Is Unavailable For This Camera');return;}
    if(cbMotionHeld)release();
    cbNumberEditor={key:key,camera:selected(),epoch:cbEpoch,replace:true};
    params.setValue('number_value',0,String(params.getValue(key,0)));
    params.setValue('number_title',0,key.replace(/_/g,' ').toUpperCase());
    params.setValue('number_limits',0,'Range '+bounds[0]+' to '+bounds[1]+(cbAllowed[key]&amp;&amp;cbAllowed[key].length?' | Values '+cbAllowed[key].join(', '):''));
    params.setValue('number_error',0,'');ogscript.reveal('number_popup');
}
function numberDigit(digit) {
    if(!cbNumberEditor)return;
    var old=cbNumberEditor.replace?'':String(params.getValue('number_value',0));cbNumberEditor.replace=false;
    if(old.length&lt;18)params.setValue('number_value',0,old+digit);
}
function numberDelete() {
    if(!cbNumberEditor)return;cbNumberEditor.replace=false;
    params.setValue('number_value',0,String(params.getValue('number_value',0)).slice(0,-1));
}
function numberSign() {
    if(!cbNumberEditor)return;cbNumberEditor.replace=false;
    var text=String(params.getValue('number_value',0));params.setValue('number_value',0,text.charAt(0)=='-'?text.substring(1):'-'+text);
}
function numberCancel() {cbNumberEditor=null;ogscript.hide('number_popup');}
function numberApply() {
    var editor=cbNumberEditor;if(!editor)return;
    if(editor.camera!=selected() || editor.epoch!=cbEpoch || !numberEditable(editor.key)){numberCancel();status('Camera Changed; Value Not Applied');return;}
    var text=String(params.getValue('number_value',0)),bounds=numberBounds(editor.key),value=Number(text);
    if(!/^-?[0-9]+$/.test(text) || !isFinite(value) || Math.floor(value)!=value || value&lt;bounds[0] || value&gt;bounds[1]){params.setValue('number_error',0,'Enter An Integer From '+bounds[0]+' To '+bounds[1]);return;}
    if(cbAllowed[editor.key]&amp;&amp;cbAllowed[editor.key].length&amp;&amp;cbAllowed[editor.key].indexOf(value)&lt;0){params.setValue('number_error',0,'Select A Listed Value');return;}
    if((editor.key=='red_gain'||editor.key=='blue_gain') &amp;&amp; value%cbGainStep){params.setValue('number_error',0,'Use Steps Of '+cbGainStep);return;}
    params.setValue(editor.key,0,CB_MANUFACTURER=='Sony'&amp;&amp;(editor.key=='shutter'||editor.key=='zoom')?String(value):value);
    numberRefresh(editor.key);numberCancel();
}

function selected() { return String(params.getValue('camera',0)); }
function send(action, data, callback) {
    if (!cbToken) { status('Sign in to control cameras.'); return; }
    if (cbHandover &amp;&amp; action!='stop') { status('Camera handover: waiting for previous stop'); return; }
    request('command',{camera:selected(),action:action,data:data || {}},callback);
}
function nextCamera() {
    if(cbCameras.length)cameraAt((cbIndex+1)%cbCameras.length);
}
function cameraAt(index) {
    if(index&gt;=cbCameras.length || cbHandover)return;
    var old=selected(),target=cbCameras[index].id;
    if(old==target)return;
    cbEpoch++;cbPending={};cbEdit={};cbMotionHeld=null;cbMotionIntent=null;cbHandover=true;
    var finish=function(r){
        cbHandover=false;
        if(!r){status('Handover stopped: previous camera stop not confirmed');return;}
        cbIndex=index;params.setAccess('camera',1);params.setValue('camera',0,target);params.setAccess('camera',0);poll();
    };
    if(cbToken)request('command',{camera:old,action:'stop',data:{}},finish);
    else finish({readOnly:true});
}
function touchEnable() {
    if(!cbToken){status('Sign in on the Config page first');return;}
    cbTouchEnabled=!cbTouchEnabled;
    ogscript.rename('touch_enable',cbTouchEnabled?'Touch control ENABLED':'Touch control DISABLED');
    if(!cbTouchEnabled)stop();
}
function pumpMotion() {
    if(cbMotionFlight || cbHandover)return;
    if(cbMotionStop) {
        cbMotionStop=false;var full=cbMotionFull;cbMotionFull=false;cbMotionFlight=true;
        request('command',{camera:selected(),action:'stop',data:{active_only:!full}},function(r){
            cbMotionFlight=false;
            if(!r){cbMotionIntent=null;cbMotionHeld=null;cbTouchEnabled=false;ogscript.rename('touch_enable','Touch control DISABLED');status('Stop failed; movement remains disabled');return;}
            pumpMotion();
        });return;
    }
    var intent=cbMotionIntent;if(!intent)return;cbMotionIntent=null;cbMotionFlight=true;
    request('command',{camera:intent.camera,action:'claim',data:{}},function(r){
        if(!r || intent.epoch!=cbEpoch || intent.camera!=selected() || cbMotionStop || cbMotionIntent){cbMotionFlight=false;pumpMotion();return;}
        var d=intent.axes;d.generation=r.generation;
        request('command',{camera:intent.camera,action:'move',data:d},function(result){
            cbMotionFlight=false;if(!result)cbMotionIntent=null;pumpMotion();
        });
    });
}
function release() {
    if(!cbToken)return;
    cbEpoch++;cbMotionIntent=null;cbMotionHeld=null;cbMotionStop=true;pumpMotion();
}
function stop() {
    if(!cbToken)return;
    cbEpoch++;cbPending={};cbMotionIntent=null;cbMotionHeld=null;cbMotionStop=true;cbMotionFull=true;pumpMotion();
}
function jog(pan,tilt,zoom,focus) {
    if(!cbTouchEnabled){status('Enable touch control before jogging');return;}
    if(!cbToken)return;
    var speed=Number(params.getValue('speed',0));
    cbMotionLast=new Date().getTime();
    cbMotionIntent={camera:selected(),epoch:cbEpoch,axes:{pan:pan*speed,tilt:tilt*speed,zoom:zoom*speed,focus:focus*speed}};
    cbMotionHeld=cbMotionIntent;pumpMotion();
}
function whiteBalance(mode) {
    if(mode==9 &amp;&amp; (!cbAllowed.wb_mode || cbAllowed.wb_mode.indexOf(9)&lt;0)){status('VAR White Balance Is Unavailable On This Camera');return;}
    if(cbCapabilities.pan_tilt_type=='digital' &amp;&amp; (mode==2 || mode==3))mode--;
    send('write',{parameter:'wb_mode',value:mode},function(r){if(r)poll();});
}
function oneShot() {
    send('white_balance_once',{},function(r){if(r){status('One Shot Sent; completion is not reported');poll();}});
}
function renamePreset() {
    var d={number:Number(params.getValue('shot_number',0)),name:String(params.getValue('shot_name',0))};
    if(cbCapabilities.preset_speed)d.speed=Number(params.getValue('recall_speed',0));
    send('label_preset',d,function(r){if(r)poll();});
}
function changed(key) {
    numberRefresh(key);
    if(cbUpdating)return;
    if(!cbToken){status('Sign in before adjustment');return;}
    var value=Number(params.getValue(key,0));
    if(key=='red_gain'||key=='blue_gain')value=Math.round(value/cbGainStep)*cbGainStep;
    cbPending[key]=value; cbEdit[key]=new Date().getTime();
}
function adjust(key,delta,low,high) {
    if(!cbToken){status('Sign in before adjustment');return;}
    if(cbRanges[key]){low=cbRanges[key][0];high=cbRanges[key][1];}
    var value=Number(params.getValue(key,0));
    if(key=='red_gain'||key=='blue_gain')delta*=cbGainStep;
    params.setValue(key,0,Math.max(low,Math.min(high,value+delta)));
}
function preset(number) {
    if(cbCapabilities.preset_max!==undefined &amp;&amp; number&gt;cbCapabilities.preset_max){status('Shot unavailable for this camera model');return;}
    var store=Number(params.getValue('store',0))==1;
    if(store &amp;&amp; String(params.getValue('confirmation',0))!='OVERWRITE') {status('Type OVERWRITE to store; then select preset');return;}
    var d={number:number,store:store,confirm:String(params.getValue('confirmation',0))};
    if(cbCapabilities.preset_speed &amp;&amp; (store || Number(params.getValue('use_saved_speed',0))==0))d.speed=Number(params.getValue('recall_speed',0));
    send('preset',d,function(r){if(r){status(r.status);poll();}});
    params.setValue('store',0,0);params.setValue('confirmation',0,'');
}
function poll() {
    refreshBridgeLink();
    if(cbBusy)return; cbBusy=true;
    var camera=selected(),epoch=cbEpoch;
    request('state',{},function(r){
        cbBusy=false; if(!r || epoch!=cbEpoch || camera!=selected())return;
        cbLastFeedback=new Date().getTime();cbCameras=[];
        for(var i=0;i&lt;r.cameras.length;i++)if(r.cameras[i].manufacturer==CB_MANUFACTURER)cbCameras.push(r.cameras[i]);
        var c=null;for(var i=0;i&lt;cbCameras.length;i++)if(cbCameras[i].id==camera){c=cbCameras[i];cbIndex=i;}
        if(!c &amp;&amp; cbCameras.length){c=cbCameras[0];cbIndex=0;cbEpoch++;cbPending={};cbTouchEnabled=false;params.setAccess('camera',1);params.setValue('camera',0,c.id);params.setAccess('camera',0);if(CB_MANUFACTURER!='Marshall')ogscript.rename('touch_enable','Touch control DISABLED');}
        if(!c){status('No enabled '+CB_MANUFACTURER+' cameras; add one in CameraBridge setup');return;}
        ogscript.rename('identity',c.name+' | '+c.model+' | input '+c.carbonite_input);
        var endpoint=((r.ross||{}).endpoints||{})[c.id]||{};
        ogscript.rename('connection','CAM '+c.number+' | '+c.health+' | '+(c.host || c.gateway || '')+' | '+(c.locked?'LOCKED':'Available')+(c.pivotcam?' | TCP '+(endpoint.port||'?')+' '+(endpoint.connected?'Connected':'Waiting')+' | Frames '+(endpoint.packets||0)+(endpoint.last_control?' | Last Control '+Math.round(r.time-endpoint.last_control)+'s Ago':' | No Control Received'):''));
        for(var n=0;n&lt;6;n++) {
            var caption=n&lt;cbCameras.length?String(cbCameras[n].name).split(' - ')[0]:'';
            ogscript.rename('camera_pick_'+n,n&lt;cbCameras.length?'CAM '+(cbCameras[n].number || (n+1))+'\n'+caption.slice(0,12):'-');
            ogscript.setStyle('camera_pick_'+n,'bg#'+(n==cbIndex?'7433bd':'494f5b')+';fg#ffffff;bdr:none;size:15;');
        }
        ogscript.setStyle('connection','fg#'+(c.health=='online'||c.health=='simulated'?'8dca95':'d7bb8c')+';size:12;txt-align:west;');
        cbCapabilities=c.capabilities||{};cbGainStep=cbCapabilities.gain_display_divisor||1;
        if(CB_MANUFACTURER=='Panasonic') {
            cbPresetSpeeds=c.preset_speeds||{};
            ogscript.rename('shot_number_label','Shot Number (1 to '+(cbCapabilities.preset_max||100)+') / Name');
            ogscript.rename('paint_help','ATW follows the scene. A / B hold white balance. VAR enables Kelvin entry; the camera uses its nearest supported value.');
            if(c.white_balance_once)ogscript.rename('awb_result','One Shot: '+c.white_balance_once.status+(c.white_balance_once.error?' | '+c.white_balance_once.error:' | completion not reported'));
            var active=c.active_preset||{};
            ogscript.rename('preset_feedback',active.number?'Shot '+active.number+' | Speed '+(active.speed||'Camera Default')+' | '+active.state:'No Shot Recalled');
            for(var n=1;n&lt;=20;n++)ogscript.rename('shot_'+n,('0'+n).slice(-2)+'\n'+((c.preset_names||{})[String(n)] || 'Shot '+n)+(cbPresetSpeeds[String(n)]?' | S'+cbPresetSpeeds[String(n)]:''));
        }
        cbUpdating=true;
        var tally=c.tally||{};
        if(CB_MANUFACTURER!='Marshall')ogscript.rename('tally_state','Tally: '+(tally.enabled?'enabled':'disabled')+' | '+(tally.status||'unknown')+(tally.error?' | '+tally.error:''));
        try {
            for(var key in c.parameters) {
                var p=c.parameters[key];cbRanges[key]=[p.low,p.high];cbAllowed[key]=p.allowed||[];
                if(cbRangeFields[key])ogscript.rename('range_'+key,'Range '+p.low+' to '+p.high);
                try {
                if(CB_MANUFACTURER=='Panasonic' &amp;&amp; (key=='red_gain'||key=='blue_gain') &amp;&amp; cbConstraints[key]!=(cbCapabilities.gain_constraint||'gain_range_'+cbGainStep)){var gainRange=cbCapabilities.gain_constraint||'gain_range_'+cbGainStep;params.replaceConstraint(key,gainRange);cbConstraints[key]=gainRange;}
                if((CB_MANUFACTURER=='Sony' &amp;&amp; key!='shutter' &amp;&amp; key!='zoom' &amp;&amp; p.supported || CB_MANUFACTURER=='Panasonic' &amp;&amp; key=='detail') &amp;&amp; p.low&lt;=p.high) {
                    var range=String(p.low)+';'+String(p.high)+';';
                    if(cbConstraints[key]!=range){params.setAccess(key,1);if(CB_MANUFACTURER=='Panasonic')params.replaceConstraint(key,'detail_range_'+p.high);else params.getParam(key,0).replaceConstraint(String(range));cbConstraints[key]=range;}
                }
                var value=p.value===null?'unknown':String(CB_MANUFACTURER=='Panasonic' &amp;&amp; (key=='red_gain'||key=='blue_gain')?(p.value-150)/(p.display_divisor||1)*(p.display_multiplier||1):p.value);
                if(CB_MANUFACTURER=='Panasonic' &amp;&amp; key=='wb_mode'){var wbNames=cbCapabilities.pan_tilt_type=='digital'?{0:'Auto ATW',1:'Manual A',2:'Manual B',3:'Auto ATW',4:'3200K',5:'5600K'}:{0:'Auto ATW',2:'Manual A',3:'Manual B',4:'3200K',5:'5600K',9:'Variable'};value=wbNames[p.value]||value;}
                ogscript.rename('actual_'+key,value+' | '+p.confirmation+' | '+(p.age_seconds===null?'never read':Math.round(p.age_seconds)+'s'));
                if(p.confirmation=='confirmed' &amp;&amp; !cbPending.hasOwnProperty(key) &amp;&amp; (!cbEdit[key] || new Date().getTime()-cbEdit[key]&gt;1000)) {
                    // DashBoard blocks local setValue while the parameter is read-only.
                    params.setAccess(key,1);params.setValue(key,0,CB_MANUFACTURER=='Sony' &amp;&amp; (key=='shutter'||key=='zoom')?String(p.value):p.value);
                }
                var enabled=!!cbToken &amp;&amp; !c.locked &amp;&amp; (p.confirmation=='confirmed'||p.readback===false&amp;&amp;p.supported&amp;&amp;c.health=='online') &amp;&amp; p.writable!==false;
                if(p.dependency){var pair=p.dependency.split('=');var m=c.parameters[pair[0]];enabled=enabled &amp;&amp; m &amp;&amp; m.confirmation=='confirmed' &amp;&amp; (','+pair[1]+',').indexOf(','+m.value+',')&gt;=0;}
                if(CB_MANUFACTURER=='Marshall' &amp;&amp; (key=='red_gain'||key=='blue_gain'))enabled=enabled &amp;&amp; c.parameters.wb_mode.value==1;
                cbWritable[key]=!!enabled;params.setAccess(key,enabled?1:0);numberRefresh(key);
                } catch(panelError) { cbNoticeUntil=new Date().getTime()+10000;status('Panel '+key+': '+String(panelError)); }
            }
        } finally {cbUpdating=false;}
        for(var localKey in cbNumberFields)if(!c.parameters[localKey])numberRefresh(localKey);
        status('Feedback refreshed | '+(cbToken?'control authenticated':'read-only; sign in to control'));
    });
}
function tick() {
    cbTick++;
    if(cbMotionHeld &amp;&amp; !cbMotionFlight &amp;&amp; !cbHandover &amp;&amp; new Date().getTime()-cbMotionLast&gt;=300){cbMotionIntent=cbMotionHeld;cbMotionLast=new Date().getTime();pumpMotion();}
    if(cbToken)for(var key in cbPending){var value=cbPending[key];delete cbPending[key];send('write',{parameter:key,value:value,snap:CB_MANUFACTURER=='Sony'},null);break;}
    if(cbTick%5==0)poll();
    if(cbLastFeedback &amp;&amp; new Date().getTime()-cbLastFeedback&gt;4000)status('STALE - no bridge feedback for '+Math.round((new Date().getTime()-cbLastFeedback)/1000)+'s');
}

cbNumberFields={"red_gain": true, "blue_gain": true, "black_level": true, "gamma": true, "colour": true, "sharpness": true, "brightness": true, "gain": true, "wb_mode": true, "exposure_auto": true, "agc_limit": true, "shutter": true, "dnr": true, "mirror": true, "flip": true, "digital_zoom": true};cbRangeFields={"red_gain": true, "blue_gain": true, "black_level": true, "gamma": true, "colour": true, "sharpness": true, "brightness": true, "gain": true, "wb_mode": true, "exposure_auto": true, "agc_limit": true, "shutter": true, "dnr": true, "mirror": true, "flip": true, "digital_zoom": true};
    var originalPoll=poll;
    poll=function(){
      if(active&amp;&amp;U.config){for(var i=0;i&lt;U.config.cameras.length;i++)if(U.config.cameras[i].id==selected()){
        U.index=i;uRoster();var c=U.config.cameras[i];uStatus('Controlling CAM '+c.number+' / '+c.name);break;}}
      originalPoll();
    };
    var originalCameraAt=cameraAt;
    cameraAt=function(index){cbTouchEnabled=false;if(CB_MANUFACTURER!='Marshall')ogscript.rename('touch_enable','Touch control DISABLED');originalCameraAt(index);};
    var originalSend=send;
    send=function(action,data,callback){if(!active&amp;&amp;action!='stop'){status('Select this camera from Cameras / Setup.');return;}originalSend(action,data,callback);};
    return {run:function(code,source){return function(){return eval(code);}.call(source);},
      enter:function(token,cid){cbToken=token;cbTouchEnabled=false;cbEpoch++;cbPending={};cbEdit={};cbConstraints={};active=true;
        params.setAccess('camera',1);params.setValue('camera',0,cid);params.setAccess('camera',0);
        if(CB_MANUFACTURER!='Marshall')ogscript.rename('touch_enable','Touch control DISABLED');poll();},
      leave:function(callback){cbEpoch++;cbPending={};cbEdit={};cbTouchEnabled=false;active=false;
        if(!cbToken){callback(true);return;}request('command',{camera:selected(),action:'stop',data:{}},function(r){if(r){cbToken='';callback(true);}else callback(false);});}};
})(params,ogscript);


var CB_Sony=(function(nativeParams,nativeScript){
    var prefix="sony_",active=false;
    var params={getValue:function(k,i){return nativeParams.getValue(k=='bridge'?'bridge':prefix+k,i);},
      setValue:function(k,i,v){nativeParams.setValue(prefix+k,i,v);},setAccess:function(k,v){nativeParams.setAccess(prefix+k,v);},
      getParam:function(k,i){return nativeParams.getParam(prefix+k,i);},
      replaceConstraint:function(k,id){nativeParams.replaceConstraint(prefix+k,prefix+id);}};
    var ogscript={reveal:function(k){nativeScript.reveal(prefix+k);},hide:function(k){nativeScript.hide(prefix+k);},rename:function(k,v){nativeScript.rename(prefix+k,v);},setStyle:function(k,v){nativeScript.setStyle(prefix+k,v);},
      asyncPost:function(u,d,c){nativeScript.asyncPost(u,d,c);},
      setXML:function(k,xml){nativeScript.setXML(prefix+k,String(xml).replace(/\bid="([^"]+)"/g,'id="'+prefix+'$1"'));}};
    var CB_MANUFACTURER='Sony';

var cbToken = '';
var cbUpdating = false;
var cbPending = {};
var cbEdit = {};
var cbCameras = [];
var cbIndex = 0;
var cbEpoch = 0;
var cbBusy = false;
var cbTick = 0;
var cbLastFeedback = 0;
var cbHandover = false;
var cbTouchEnabled = false;
var cbNoticeUntil = 0;
var cbConstraints = {};
var cbRanges = {};
var cbGainStep=1;
var cbCapabilities = {};
var cbWritable={},cbAllowed={},cbNumberEditor=null;
var cbNumberFields={},cbRangeFields={};
var cbPresetSpeeds = {};
var cbMotionFlight=false, cbMotionIntent=null, cbMotionHeld=null, cbMotionLast=0, cbMotionStop=false, cbMotionFull=false;
function status(text) {
    if(String(text).indexOf('Feedback refreshed')==0 &amp;&amp; new Date().getTime()&lt;cbNoticeUntil)return;
    ogscript.rename('status', text);
}
function highlightPage(name) {
    var pages=CB_MANUFACTURER=='Sony'?['Lens','Paint','Tally','Config']:CB_MANUFACTURER=='Panasonic'?['PTZ','Presets','Paint','Config']:['Paint','Image','Exposure','OSD','Config'];
    for(var i=0;i&lt;pages.length;i++)ogscript.setStyle('nav_'+pages[i].toLowerCase(),'bg#'+(pages[i]==name?'7433bd':'494f5b')+';fg#ffffff;bdr:none;');
}
function request(path, data, callback) {
    data.token = cbToken;
    var base = String(params.getValue('bridge', 0));
    ogscript.asyncPost(base + '/api/' + path, 'request=' + encodeURIComponent(JSON.stringify(data)), function(raw) {
        try {
            var result = JSON.parse(String(raw));
            if(!result){if(path!='state')status('No Command Reply; Check Feedback');if(callback)callback(null);return;}
            if (result.error) { status(result.error); if (callback) callback(null); return; }
            if (callback) callback(result);
        } catch (e) { cbNoticeUntil=new Date().getTime()+10000;status('Panel Error: '+String(e)); if (callback) callback(null); }
    });
}
function login() {
    var data = {username:String(params.getValue('username',0)),password:String(params.getValue('password',0))};
    params.setValue('password',0,'');
    request('login', data, function(r) { if(r) {cbToken = r.token; status('Authenticated ' + r.role); poll();} });
}
var cbLinkUrl = '';
function refreshBridgeLink() {
    var url=String(params.getValue('bridge',0)).replace(/\/+$/,'')+'/';
    if(url==cbLinkUrl)return;
    var valid=/^https?:\/\/[A-Za-z0-9.\-:\[\]]+\/$/.test(url);
    var html=valid?'&lt;html&gt;&lt;p&gt;Select this link to open setup:&lt;/p&gt;&lt;a href="'+url+'"&gt;&lt;font size="5" color="#80d9eb"&gt;'+url+'&lt;/font&gt;&lt;/a&gt;&lt;p&gt;Sign in in the browser to control cameras.&lt;/p&gt;&lt;/html&gt;':'&lt;html&gt;Set a valid HTTP or HTTPS backend URL on Config.&lt;/html&gt;';
    ogscript.setXML('bridge_launcher','&lt;help id="open_bridge" left="0" top="0" width="180" height="56" name="Open setup" title="CameraBridge setup" popupwidth="600" popupheight="180" style="bg#49a8d8;fg#ffffff;size:16;"&gt;&lt;![CDATA['+html+']]&gt;&lt;/help&gt;');
    cbLinkUrl=url;
}

function numberFormat(key,value) {
    return value===null || value===undefined?'Unknown':String(value);
}
function numberRefresh(key) {
    if(cbNumberFields[key])ogscript.rename('number_entry_'+key,numberFormat(key,params.getValue(key,0)));
}
function numberBounds(key) {
    if(key=='speed')return [1,49];
    if(key=='recall_speed')return [1,30];
    if(key=='shot_number')return [1,cbCapabilities.preset_max===undefined?100:cbCapabilities.preset_max];
    return cbRanges[key];
}
function numberEditable(key) {
    return !!cbToken &amp;&amp; !cbHandover &amp;&amp; ((key=='speed'||key=='recall_speed'||key=='shot_number') || cbWritable[key]===true);
}
function numberOpen(key) {
    if(!numberEditable(key)){status('This Value Is Read Only');return;}
    var bounds=numberBounds(key);if(!bounds){status('Wait For Camera Range Feedback');return;}
    if(key=='recall_speed' &amp;&amp; cbCapabilities.preset_speed===false){status('Recall Speed Is Unavailable For This Camera');return;}
    if(cbMotionHeld)release();
    cbNumberEditor={key:key,camera:selected(),epoch:cbEpoch,replace:true};
    params.setValue('number_value',0,String(params.getValue(key,0)));
    params.setValue('number_title',0,key.replace(/_/g,' ').toUpperCase());
    params.setValue('number_limits',0,'Range '+bounds[0]+' to '+bounds[1]+(cbAllowed[key]&amp;&amp;cbAllowed[key].length?' | Values '+cbAllowed[key].join(', '):''));
    params.setValue('number_error',0,'');ogscript.reveal('number_popup');
}
function numberDigit(digit) {
    if(!cbNumberEditor)return;
    var old=cbNumberEditor.replace?'':String(params.getValue('number_value',0));cbNumberEditor.replace=false;
    if(old.length&lt;18)params.setValue('number_value',0,old+digit);
}
function numberDelete() {
    if(!cbNumberEditor)return;cbNumberEditor.replace=false;
    params.setValue('number_value',0,String(params.getValue('number_value',0)).slice(0,-1));
}
function numberSign() {
    if(!cbNumberEditor)return;cbNumberEditor.replace=false;
    var text=String(params.getValue('number_value',0));params.setValue('number_value',0,text.charAt(0)=='-'?text.substring(1):'-'+text);
}
function numberCancel() {cbNumberEditor=null;ogscript.hide('number_popup');}
function numberApply() {
    var editor=cbNumberEditor;if(!editor)return;
    if(editor.camera!=selected() || editor.epoch!=cbEpoch || !numberEditable(editor.key)){numberCancel();status('Camera Changed; Value Not Applied');return;}
    var text=String(params.getValue('number_value',0)),bounds=numberBounds(editor.key),value=Number(text);
    if(!/^-?[0-9]+$/.test(text) || !isFinite(value) || Math.floor(value)!=value || value&lt;bounds[0] || value&gt;bounds[1]){params.setValue('number_error',0,'Enter An Integer From '+bounds[0]+' To '+bounds[1]);return;}
    if(cbAllowed[editor.key]&amp;&amp;cbAllowed[editor.key].length&amp;&amp;cbAllowed[editor.key].indexOf(value)&lt;0){params.setValue('number_error',0,'Select A Listed Value');return;}
    if((editor.key=='red_gain'||editor.key=='blue_gain') &amp;&amp; value%cbGainStep){params.setValue('number_error',0,'Use Steps Of '+cbGainStep);return;}
    params.setValue(editor.key,0,CB_MANUFACTURER=='Sony'&amp;&amp;(editor.key=='shutter'||editor.key=='zoom')?String(value):value);
    numberRefresh(editor.key);numberCancel();
}

function selected() { return String(params.getValue('camera',0)); }
function send(action, data, callback) {
    if (!cbToken) { status('Sign in to control cameras.'); return; }
    if (cbHandover &amp;&amp; action!='stop') { status('Camera handover: waiting for previous stop'); return; }
    request('command',{camera:selected(),action:action,data:data || {}},callback);
}
function nextCamera() {
    if(cbCameras.length)cameraAt((cbIndex+1)%cbCameras.length);
}
function cameraAt(index) {
    if(index&gt;=cbCameras.length || cbHandover)return;
    var old=selected(),target=cbCameras[index].id;
    if(old==target)return;
    cbEpoch++;cbPending={};cbEdit={};cbMotionHeld=null;cbMotionIntent=null;cbHandover=true;
    var finish=function(r){
        cbHandover=false;
        if(!r){status('Handover stopped: previous camera stop not confirmed');return;}
        cbIndex=index;params.setAccess('camera',1);params.setValue('camera',0,target);params.setAccess('camera',0);poll();
    };
    if(cbToken)request('command',{camera:old,action:'stop',data:{}},finish);
    else finish({readOnly:true});
}
function touchEnable() {
    if(!cbToken){status('Sign in on the Config page first');return;}
    cbTouchEnabled=!cbTouchEnabled;
    ogscript.rename('touch_enable',cbTouchEnabled?'Touch control ENABLED':'Touch control DISABLED');
    if(!cbTouchEnabled)stop();
}
function pumpMotion() {
    if(cbMotionFlight || cbHandover)return;
    if(cbMotionStop) {
        cbMotionStop=false;var full=cbMotionFull;cbMotionFull=false;cbMotionFlight=true;
        request('command',{camera:selected(),action:'stop',data:{active_only:!full}},function(r){
            cbMotionFlight=false;
            if(!r){cbMotionIntent=null;cbMotionHeld=null;cbTouchEnabled=false;ogscript.rename('touch_enable','Touch control DISABLED');status('Stop failed; movement remains disabled');return;}
            pumpMotion();
        });return;
    }
    var intent=cbMotionIntent;if(!intent)return;cbMotionIntent=null;cbMotionFlight=true;
    request('command',{camera:intent.camera,action:'claim',data:{}},function(r){
        if(!r || intent.epoch!=cbEpoch || intent.camera!=selected() || cbMotionStop || cbMotionIntent){cbMotionFlight=false;pumpMotion();return;}
        var d=intent.axes;d.generation=r.generation;
        request('command',{camera:intent.camera,action:'move',data:d},function(result){
            cbMotionFlight=false;if(!result)cbMotionIntent=null;pumpMotion();
        });
    });
}
function release() {
    if(!cbToken)return;
    cbEpoch++;cbMotionIntent=null;cbMotionHeld=null;cbMotionStop=true;pumpMotion();
}
function stop() {
    if(!cbToken)return;
    cbEpoch++;cbPending={};cbMotionIntent=null;cbMotionHeld=null;cbMotionStop=true;cbMotionFull=true;pumpMotion();
}
function jog(pan,tilt,zoom,focus) {
    if(!cbTouchEnabled){status('Enable touch control before jogging');return;}
    if(!cbToken)return;
    var speed=Number(params.getValue('speed',0));
    cbMotionLast=new Date().getTime();
    cbMotionIntent={camera:selected(),epoch:cbEpoch,axes:{pan:pan*speed,tilt:tilt*speed,zoom:zoom*speed,focus:focus*speed}};
    cbMotionHeld=cbMotionIntent;pumpMotion();
}
function whiteBalance(mode) {
    if(mode==9 &amp;&amp; (!cbAllowed.wb_mode || cbAllowed.wb_mode.indexOf(9)&lt;0)){status('VAR White Balance Is Unavailable On This Camera');return;}
    if(cbCapabilities.pan_tilt_type=='digital' &amp;&amp; (mode==2 || mode==3))mode--;
    send('write',{parameter:'wb_mode',value:mode},function(r){if(r)poll();});
}
function oneShot() {
    send('white_balance_once',{},function(r){if(r){status('One Shot Sent; completion is not reported');poll();}});
}
function renamePreset() {
    var d={number:Number(params.getValue('shot_number',0)),name:String(params.getValue('shot_name',0))};
    if(cbCapabilities.preset_speed)d.speed=Number(params.getValue('recall_speed',0));
    send('label_preset',d,function(r){if(r)poll();});
}
function changed(key) {
    numberRefresh(key);
    if(cbUpdating)return;
    if(!cbToken){status('Sign in before adjustment');return;}
    var value=Number(params.getValue(key,0));
    if(key=='red_gain'||key=='blue_gain')value=Math.round(value/cbGainStep)*cbGainStep;
    cbPending[key]=value; cbEdit[key]=new Date().getTime();
}
function adjust(key,delta,low,high) {
    if(!cbToken){status('Sign in before adjustment');return;}
    if(cbRanges[key]){low=cbRanges[key][0];high=cbRanges[key][1];}
    var value=Number(params.getValue(key,0));
    if(key=='red_gain'||key=='blue_gain')delta*=cbGainStep;
    params.setValue(key,0,Math.max(low,Math.min(high,value+delta)));
}
function preset(number) {
    if(cbCapabilities.preset_max!==undefined &amp;&amp; number&gt;cbCapabilities.preset_max){status('Shot unavailable for this camera model');return;}
    var store=Number(params.getValue('store',0))==1;
    if(store &amp;&amp; String(params.getValue('confirmation',0))!='OVERWRITE') {status('Type OVERWRITE to store; then select preset');return;}
    var d={number:number,store:store,confirm:String(params.getValue('confirmation',0))};
    if(cbCapabilities.preset_speed &amp;&amp; (store || Number(params.getValue('use_saved_speed',0))==0))d.speed=Number(params.getValue('recall_speed',0));
    send('preset',d,function(r){if(r){status(r.status);poll();}});
    params.setValue('store',0,0);params.setValue('confirmation',0,'');
}
function poll() {
    refreshBridgeLink();
    if(cbBusy)return; cbBusy=true;
    var camera=selected(),epoch=cbEpoch;
    request('state',{},function(r){
        cbBusy=false; if(!r || epoch!=cbEpoch || camera!=selected())return;
        cbLastFeedback=new Date().getTime();cbCameras=[];
        for(var i=0;i&lt;r.cameras.length;i++)if(r.cameras[i].manufacturer==CB_MANUFACTURER)cbCameras.push(r.cameras[i]);
        var c=null;for(var i=0;i&lt;cbCameras.length;i++)if(cbCameras[i].id==camera){c=cbCameras[i];cbIndex=i;}
        if(!c &amp;&amp; cbCameras.length){c=cbCameras[0];cbIndex=0;cbEpoch++;cbPending={};cbTouchEnabled=false;params.setAccess('camera',1);params.setValue('camera',0,c.id);params.setAccess('camera',0);if(CB_MANUFACTURER!='Marshall')ogscript.rename('touch_enable','Touch control DISABLED');}
        if(!c){status('No enabled '+CB_MANUFACTURER+' cameras; add one in CameraBridge setup');return;}
        ogscript.rename('identity',c.name+' | '+c.model+' | input '+c.carbonite_input);
        var endpoint=((r.ross||{}).endpoints||{})[c.id]||{};
        ogscript.rename('connection','CAM '+c.number+' | '+c.health+' | '+(c.host || c.gateway || '')+' | '+(c.locked?'LOCKED':'Available')+(c.pivotcam?' | TCP '+(endpoint.port||'?')+' '+(endpoint.connected?'Connected':'Waiting')+' | Frames '+(endpoint.packets||0)+(endpoint.last_control?' | Last Control '+Math.round(r.time-endpoint.last_control)+'s Ago':' | No Control Received'):''));
        for(var n=0;n&lt;6;n++) {
            var caption=n&lt;cbCameras.length?String(cbCameras[n].name).split(' - ')[0]:'';
            ogscript.rename('camera_pick_'+n,n&lt;cbCameras.length?'CAM '+(cbCameras[n].number || (n+1))+'\n'+caption.slice(0,12):'-');
            ogscript.setStyle('camera_pick_'+n,'bg#'+(n==cbIndex?'7433bd':'494f5b')+';fg#ffffff;bdr:none;size:15;');
        }
        ogscript.setStyle('connection','fg#'+(c.health=='online'||c.health=='simulated'?'8dca95':'d7bb8c')+';size:12;txt-align:west;');
        cbCapabilities=c.capabilities||{};cbGainStep=cbCapabilities.gain_display_divisor||1;
        if(CB_MANUFACTURER=='Panasonic') {
            cbPresetSpeeds=c.preset_speeds||{};
            ogscript.rename('shot_number_label','Shot Number (1 to '+(cbCapabilities.preset_max||100)+') / Name');
            ogscript.rename('paint_help','ATW follows the scene. A / B hold white balance. VAR enables Kelvin entry; the camera uses its nearest supported value.');
            if(c.white_balance_once)ogscript.rename('awb_result','One Shot: '+c.white_balance_once.status+(c.white_balance_once.error?' | '+c.white_balance_once.error:' | completion not reported'));
            var active=c.active_preset||{};
            ogscript.rename('preset_feedback',active.number?'Shot '+active.number+' | Speed '+(active.speed||'Camera Default')+' | '+active.state:'No Shot Recalled');
            for(var n=1;n&lt;=20;n++)ogscript.rename('shot_'+n,('0'+n).slice(-2)+'\n'+((c.preset_names||{})[String(n)] || 'Shot '+n)+(cbPresetSpeeds[String(n)]?' | S'+cbPresetSpeeds[String(n)]:''));
        }
        cbUpdating=true;
        var tally=c.tally||{};
        if(CB_MANUFACTURER!='Marshall')ogscript.rename('tally_state','Tally: '+(tally.enabled?'enabled':'disabled')+' | '+(tally.status||'unknown')+(tally.error?' | '+tally.error:''));
        try {
            for(var key in c.parameters) {
                var p=c.parameters[key];cbRanges[key]=[p.low,p.high];cbAllowed[key]=p.allowed||[];
                if(cbRangeFields[key])ogscript.rename('range_'+key,'Range '+p.low+' to '+p.high);
                try {
                if(CB_MANUFACTURER=='Panasonic' &amp;&amp; (key=='red_gain'||key=='blue_gain') &amp;&amp; cbConstraints[key]!=(cbCapabilities.gain_constraint||'gain_range_'+cbGainStep)){var gainRange=cbCapabilities.gain_constraint||'gain_range_'+cbGainStep;params.replaceConstraint(key,gainRange);cbConstraints[key]=gainRange;}
                if((CB_MANUFACTURER=='Sony' &amp;&amp; key!='shutter' &amp;&amp; key!='zoom' &amp;&amp; p.supported || CB_MANUFACTURER=='Panasonic' &amp;&amp; key=='detail') &amp;&amp; p.low&lt;=p.high) {
                    var range=String(p.low)+';'+String(p.high)+';';
                    if(cbConstraints[key]!=range){params.setAccess(key,1);if(CB_MANUFACTURER=='Panasonic')params.replaceConstraint(key,'detail_range_'+p.high);else params.getParam(key,0).replaceConstraint(String(range));cbConstraints[key]=range;}
                }
                var value=p.value===null?'unknown':String(CB_MANUFACTURER=='Panasonic' &amp;&amp; (key=='red_gain'||key=='blue_gain')?(p.value-150)/(p.display_divisor||1)*(p.display_multiplier||1):p.value);
                if(CB_MANUFACTURER=='Panasonic' &amp;&amp; key=='wb_mode'){var wbNames=cbCapabilities.pan_tilt_type=='digital'?{0:'Auto ATW',1:'Manual A',2:'Manual B',3:'Auto ATW',4:'3200K',5:'5600K'}:{0:'Auto ATW',2:'Manual A',3:'Manual B',4:'3200K',5:'5600K',9:'Variable'};value=wbNames[p.value]||value;}
                ogscript.rename('actual_'+key,value+' | '+p.confirmation+' | '+(p.age_seconds===null?'never read':Math.round(p.age_seconds)+'s'));
                if(p.confirmation=='confirmed' &amp;&amp; !cbPending.hasOwnProperty(key) &amp;&amp; (!cbEdit[key] || new Date().getTime()-cbEdit[key]&gt;1000)) {
                    // DashBoard blocks local setValue while the parameter is read-only.
                    params.setAccess(key,1);params.setValue(key,0,CB_MANUFACTURER=='Sony' &amp;&amp; (key=='shutter'||key=='zoom')?String(p.value):p.value);
                }
                var enabled=!!cbToken &amp;&amp; !c.locked &amp;&amp; (p.confirmation=='confirmed'||p.readback===false&amp;&amp;p.supported&amp;&amp;c.health=='online') &amp;&amp; p.writable!==false;
                if(p.dependency){var pair=p.dependency.split('=');var m=c.parameters[pair[0]];enabled=enabled &amp;&amp; m &amp;&amp; m.confirmation=='confirmed' &amp;&amp; (','+pair[1]+',').indexOf(','+m.value+',')&gt;=0;}
                if(CB_MANUFACTURER=='Marshall' &amp;&amp; (key=='red_gain'||key=='blue_gain'))enabled=enabled &amp;&amp; c.parameters.wb_mode.value==1;
                cbWritable[key]=!!enabled;params.setAccess(key,enabled?1:0);numberRefresh(key);
                } catch(panelError) { cbNoticeUntil=new Date().getTime()+10000;status('Panel '+key+': '+String(panelError)); }
            }
        } finally {cbUpdating=false;}
        for(var localKey in cbNumberFields)if(!c.parameters[localKey])numberRefresh(localKey);
        status('Feedback refreshed | '+(cbToken?'control authenticated':'read-only; sign in to control'));
    });
}
function tick() {
    cbTick++;
    if(cbMotionHeld &amp;&amp; !cbMotionFlight &amp;&amp; !cbHandover &amp;&amp; new Date().getTime()-cbMotionLast&gt;=300){cbMotionIntent=cbMotionHeld;cbMotionLast=new Date().getTime();pumpMotion();}
    if(cbToken)for(var key in cbPending){var value=cbPending[key];delete cbPending[key];send('write',{parameter:key,value:value,snap:CB_MANUFACTURER=='Sony'},null);break;}
    if(cbTick%5==0)poll();
    if(cbLastFeedback &amp;&amp; new Date().getTime()-cbLastFeedback&gt;4000)status('STALE - no bridge feedback for '+Math.round((new Date().getTime()-cbLastFeedback)/1000)+'s');
}

cbNumberFields={"iris": true, "iris_auto": true, "focus_auto": true, "red_gain": true, "blue_gain": true, "colour_temperature": true, "wb_mode": true, "gain": true, "shutter": true};cbRangeFields={"iris": true, "iris_auto": true, "focus_auto": true, "red_gain": true, "blue_gain": true, "colour_temperature": true, "wb_mode": true, "gain": true, "shutter": true};
    var originalPoll=poll;
    poll=function(){
      if(active&amp;&amp;U.config){for(var i=0;i&lt;U.config.cameras.length;i++)if(U.config.cameras[i].id==selected()){
        U.index=i;uRoster();var c=U.config.cameras[i];uStatus('Controlling CAM '+c.number+' / '+c.name);break;}}
      originalPoll();
    };
    var originalCameraAt=cameraAt;
    cameraAt=function(index){cbTouchEnabled=false;if(CB_MANUFACTURER!='Marshall')ogscript.rename('touch_enable','Touch control DISABLED');originalCameraAt(index);};
    var originalSend=send;
    send=function(action,data,callback){if(!active&amp;&amp;action!='stop'){status('Select this camera from Cameras / Setup.');return;}originalSend(action,data,callback);};
    return {run:function(code,source){return function(){return eval(code);}.call(source);},
      enter:function(token,cid){cbToken=token;cbTouchEnabled=false;cbEpoch++;cbPending={};cbEdit={};cbConstraints={};active=true;
        params.setAccess('camera',1);params.setValue('camera',0,cid);params.setAccess('camera',0);
        if(CB_MANUFACTURER!='Marshall')ogscript.rename('touch_enable','Touch control DISABLED');poll();},
      leave:function(callback){cbEpoch++;cbPending={};cbEdit={};cbTouchEnabled=false;active=false;
        if(!cbToken){callback(true);return;}request('command',{camera:selected(),action:'stop',data:{}},function(r){if(r){cbToken='';callback(true);}else callback(false);});}};
})(params,ogscript);

var U_PANELS={Panasonic:CB_Panasonic,Marshall:CB_Marshall,Sony:CB_Sony};
// Shared native camera setup. Passwords are cleared before each HTTP request.
var U={token:'',role:'',config:null,revision:'',index:0,editing:'',maker:'',switching:false};
var U_PROFILES=['panasonic','sony-sdk','marshall-CV226','marshall-CV228'].concat(["panasonic:AW-HE35", "panasonic:AW-HE38", "panasonic:AW-HE40", "panasonic:AW-HE48", "panasonic:AW-HE58", "panasonic:AW-HE65", "panasonic:AW-HE70", "panasonic:AW-HN38", "panasonic:AW-HN40", "panasonic:AW-HN65", "panasonic:AW-HN70", "panasonic:AW-SFU01", "panasonic:AW-HE42", "panasonic:AW-HE68", "panasonic:AW-HE75", "panasonic:AW-UE63", "panasonic:AW-UE65", "panasonic:AW-UE70", "panasonic:AW-UN70", "panasonic:AW-HE145", "panasonic:AW-UE100", "panasonic:AW-UE150", "panasonic:AW-UE155", "panasonic:AW-UN145", "panasonic:AW-HE50", "panasonic:AW-HEF5", "panasonic:AW-HE60", "panasonic:AW-HE120", "panasonic:AW-HR140", "panasonic:AW-HE2", "panasonic:AW-UE4", "panasonic:AK-UB300", "panasonic:AG-CX350", "panasonic:AG-CX200", "panasonic:AJ-UPX360", "panasonic:AJ-CX4000", "panasonic:AJ-UPX900", "panasonic:Other"]).concat(['panasonic-serial']);
function uValue(key){return params.getValue('setup_'+key,0);}
function uSet(key,value){params.setValue('setup_'+key,0,value);}
function uStatus(text){ogscript.rename('unified_status',String(text));}
function uRequest(path,data,callback){
    data.token=U.token;
    ogscript.asyncPost(String(params.getValue('bridge',0)).replace(/\/+$/,'')+'/api/'+path,'request='+encodeURIComponent(JSON.stringify(data)),function(raw){
        var r;try{r=JSON.parse(String(raw));}
        catch(e){uStatus('Cannot read CameraBridge response. Check the connection.');if(callback)callback(null);return;}
        if(!r){if(path!='state')uStatus('No reply received. Check the connection.');if(callback)callback(null);return;}
        if(r.error){uStatus(r.error);if(callback)callback(null);return;}
        if(callback)try{callback(r);}catch(e){uStatus('Panel update failed: '+String(e).slice(0,160));}
    });
}
function uLogin(){
    var data={username:String(params.getValue('username',0)),password:String(params.getValue('password',0))};
    params.setValue('password',0,'');
    uRequest('login',data,function(r){if(!r)return;U.token=r.token;U.role=r.role;uStatus('Signed in as '+r.role);uLoad();});
}
function uLeave(callback){
    if(U.switching){uStatus('Wait for the previous camera to stop.');return;}
    if(!U.maker){callback();return;}
    U.switching=true;
    U_PANELS[U.maker].leave(function(ok){U.switching=false;if(ok){U.maker='';callback();}else uStatus('Previous camera stop failed. Check CameraBridge before changing cameras.');});
}
function uSetup(){uLeave(function(){ogscript.reveal('unified_setup');});}
function uLogout(){uLeave(function(){uRequest('logout',{},function(){U.token='';U.role='';uStatus('Signed out');});ogscript.reveal('unified_setup');});}
function uLoad(){
    if(!U.token){uStatus('Sign in to load camera setup.');return;}
    if(U.role!='admin'){uStatus('Operator signed in. Administrator access is required to change camera setup.');uLive();return;}
    uRequest('setup',{operation:'load'},function(r){if(!r)return;U.config=r.configuration;U.revision=r.revision;U.index=Math.min(U.index,Math.max(0,U.config.cameras.length-1));uBridgeRead();uRoster();uStatus(r.pending?'Loaded saved setup. Apply it to update the running service.':'Loaded running camera setup.');});
}
function uLive(){uRequest('state',{},function(r){if(!r)return;U.config={cameras:r.cameras};uRoster();});}
function uRoster(){
    var cameras=U.config?U.config.cameras:[];
    for(var n=0;n&lt;8;n++){
        var i=Math.floor(U.index/8)*8+n,c=cameras[i];
        ogscript.rename('roster_'+n,c?'CAM '+c.number+'  '+c.name+'\n'+c.manufacturer+' '+c.model+(c.enabled===false?' / disabled':''):'-');
        ogscript.setStyle('roster_'+n,'bg#'+(i==U.index?'7433bd':'494f5b')+';fg#ffffff;size:16;');
    }
    var c=cameras[U.index];ogscript.rename('setup_selected',c?'Selected: CAM '+c.number+' / '+c.name:'No configured cameras');
}
function uPick(slot){if(!U.config)return;var index=Math.floor(U.index/8)*8+slot;if(index&gt;=U.config.cameras.length)return;U.index=index;uEdit();uRoster();}
function uListPage(delta){if(!U.config||!U.config.cameras.length)return;U.index=(Math.floor(U.index/8)*8+delta*8+Math.ceil(U.config.cameras.length/8)*8)%(Math.ceil(U.config.cameras.length/8)*8);uRoster();}
function uProfile(){
    var p=U_PROFILES[Number(uValue('profile'))];
    if(p.indexOf('marshall-CV')==0){uSet('pivot',0);uSet('enabled',0);}
    ogscript.rename('setup_profile_help',p=='panasonic-serial'?'Enter the USR gateway IP and TCP port. RS-422: 9600 8N1. Head jog, iris and tally commands have no lamp or position feedback. Shots 1-50; recall speed unavailable.':p=='sony-sdk'?'Sony: save the camera, then set access on the Camera access page.':p.indexOf('marshall-CV')==0?'Marshall hardware control is pending. Save this profile disabled.':p=='marshall-lab'?'Marshall simulator only. No serial packets are sent.':'Panasonic CGI compatibility profile. HE2: digital PTZ, shots 1–9, no focus. Unsupported controls stay read-only. HTTP authentication is not implemented.');
}
function uNew(){
    U.editing='';var used={},number=1;
    if(U.config)for(var i=0;i&lt;U.config.cameras.length;i++)used[U.config.cameras[i].number]=true;
    while(used[number]&amp;&amp;number&lt;255)number++;
    var defaults={name:'Camera '+number,profile:0,host:'',port:80,number:number,input:number,enabled:1,pivot:1,store:0,tally:1,address:Math.min(number,126),remove:'',access_user:'',access_password:'',fingerprint:'',terms:0};
    for(var key in defaults)uSet(key,defaults[key]);uProfile();uStatus('New camera. Save the camera, then apply the saved setup.');
}
function uEdit(){
    if(!U.config||!U.config.cameras[U.index])return;var c=U.config.cameras[U.index];U.editing=c.id;
    var p=c.driver=='panasonic'?(c.simulator?'panasonic-sim':c.model=='AW-HE130'?'panasonic':'panasonic:'+c.model):c.driver=='marshall-pending'?'marshall-'+c.model:c.driver;
    var values={name:c.name,profile:Math.max(0,U_PROFILES.indexOf(p)),host:c.host||'',port:c.port||80,number:c.number,input:c.carbonite_input,enabled:c.enabled===false?0:1,pivot:c.pivotcam?1:0,store:c.allow_store?1:0,tally:c.tally_enabled===false?0:1,address:c.tally_address===undefined?Math.min(c.carbonite_input,126):c.tally_address,remove:'',access_user:'',access_password:'',fingerprint:'',terms:0};
    for(var key in values)uSet(key,values[key]);uProfile();uStatus('Editing '+c.name+'. Access passwords are not read back.');
}
function uSave(){
    if(U.role!='admin'||!U.config){uStatus('Sign in as administrator, then load the camera list.');return;}
    var p=U_PROFILES[Number(uValue('profile'))],old=null;
    for(var i=0;i&lt;U.config.cameras.length;i++)if(U.config.cameras[i].id==U.editing)old=U.config.cameras[i];
    var c={};if(old)for(var key in old)c[key]=old[key];
    c.number=Number(uValue('number'));c.id=U.editing||'camera_'+c.number;
    c.name=String(uValue('name')).replace(/^\s+|\s+$/g,'');
    if(!c.name){uStatus('Enter a camera name.');return;}
    c.driver=p=='panasonic-serial'?'panasonic-serial':p.indexOf('panasonic')==0?'panasonic':p.indexOf('marshall-CV')==0?'marshall-pending':p;
    c.manufacturer=p=='sony-sdk'?'Sony':p.indexOf('marshall')==0?'Marshall':'Panasonic';
    c.model=p=='panasonic-serial'?'AK-HC1800G + AW-PH360N':p=='sony-sdk'?'PXW-Z200':p=='marshall-CV226'?'CV226':c.manufacturer=='Marshall'?'CV228':p.indexOf('panasonic:')==0?p.substring(10):'AW-HE130';
    c.host=String(uValue('host')).replace(/^\s+|\s+$/g,'');c.port=Number(uValue('port'));c.carbonite_input=Number(uValue('input'));
    c.simulator=p=='panasonic-sim'||p=='marshall-lab';c.enabled=Number(uValue('enabled'))==1;c.pivotcam=Number(uValue('pivot'))==1;
    c.allow_store=Number(uValue('store'))==1;c.tally_enabled=Number(uValue('tally'))==1;c.tally_address=Number(uValue('address'));
    if(c.driver=='marshall-lab'){c.gateway='LAB ONLY';c.address=1;}
    uRequest('setup',{operation:'save',revision:U.revision,previous:U.editing,camera:c},function(r){if(!r)return;U.config=r.configuration;U.revision=r.revision;U.editing=c.id;for(var i=0;i&lt;U.config.cameras.length;i++)if(U.config.cameras[i].id==c.id)U.index=i;uRoster();uStatus(r.status);});
}
function uRemove(){
    if(!U.editing){uStatus('Select a saved camera first.');return;}
    var confirmation=String(uValue('remove'));uSet('remove','');
    uRequest('setup',{operation:'remove',revision:U.revision,camera:U.editing,confirmation:confirmation},function(r){if(!r)return;U.config=r.configuration;U.revision=r.revision;U.index=0;uNew();uRoster();uStatus(r.status);});
}
function uApply(){uLeave(function(){uRequest('setup',{operation:'apply',revision:U.revision},function(r){if(r)uStatus(r.status);});});}
function uControl(){
    if(!U.config||!U.config.cameras[U.index]){uStatus('Load the list and select a camera first.');return;}
    var c=U.config.cameras[U.index];
    uRequest('state',{},function(r){if(!r)return;var found=false,live=null;for(var i=0;i&lt;r.cameras.length;i++)if(r.cameras[i].id==c.id){found=true;live=r.cameras[i];}
        if(!found){uStatus('Camera is not running. Enable it and apply the saved setup first.');return;}
        var keys=['host','port','driver','manufacturer','model','number','carbonite_input','enabled','simulator'];
        for(var k=0;k&lt;keys.length;k++)if(String(c[keys[k]])!=String(live[keys[k]])){uStatus('Camera setup differs from the running camera. Apply saved setup, then reload the list.');return;}
        uLeave(function(){U.maker=c.manufacturer;U_PANELS[U.maker].enter(U.token,c.id);ogscript.reveal('unified_'+U.maker);uStatus('Controlling CAM '+c.number+' / '+c.name);});
    });
}
function uFingerprint(){
    if(U_PROFILES[Number(uValue('profile'))]!='sony-sdk'){uStatus('SSH access applies to the Sony SDK profile.');return;}
    uRequest('sony/fingerprint',{host:String(uValue('host'))},function(r){if(r){uSet('fingerprint',r.fingerprint);uStatus('Compare the fingerprint with the camera identity before saving access.');}});
}
function uSaveAccess(){
    var data={camera:U.editing,username:String(uValue('access_user')),password:String(uValue('access_password')),fingerprint:String(uValue('fingerprint')),acknowledge_terms:Number(uValue('terms'))==1};
    uSet('access_password','');
    if(!U.editing||U_PROFILES[Number(uValue('profile'))]!='sony-sdk'){uStatus('Save or select a Sony camera first.');return;}
    uRequest('sony/credentials',data,function(r){if(r)uStatus(r.status);});
}
function uTick(){if(U.maker&amp;&amp;!U.switching)U_PANELS[U.maker].run('tick();');}
function uClose(){params.setValue('password',0,'');uSet('access_password','');if(U.maker)U_PANELS[U.maker].leave(function(){});}
function uBridgeRead(){
    var p=U.config.pivotcam||{},t=U.config.tally||{};
    var fields={bridge_pivot:p.enabled?1:0,bridge_bind:p.bind||'127.0.0.1',bridge_controller:p.controller||'192.168.96.123',bridge_first:(p.base_port===undefined?19010:p.base_port)+1,bridge_tally:t.enabled?1:0,bridge_tally_bind:t.bind||'127.0.0.1',bridge_tally_source:t.source||'192.168.96.123',bridge_tally_port:t.port||5727,bridge_program:t.program_tally===1?0:1,bridge_offset:(t.address_offset||0)+1};
    for(var key in fields)uSet(key,fields[key]);
}
function uBridgeSave(){
    if(U.role!='admin'||!U.config){uStatus('Sign in as administrator, then load the camera list.');return;}
    var p={},t={},key;for(key in (U.config.pivotcam||{}))p[key]=U.config.pivotcam[key];for(key in (U.config.tally||{}))t[key]=U.config.tally[key];
    p.enabled=Number(uValue('bridge_pivot'))==1;p.bind=String(uValue('bridge_bind'));p.controller=String(uValue('bridge_controller'));p.base_port=Number(uValue('bridge_first'))-1;
    t.enabled=Number(uValue('bridge_tally'))==1;t.bind=String(uValue('bridge_tally_bind'));t.source=String(uValue('bridge_tally_source'));t.port=Number(uValue('bridge_tally_port'));t.program_tally=Number(uValue('bridge_program'))+1;t.address_offset=Number(uValue('bridge_offset'))-1;
    uRequest('setup',{operation:'bridge',revision:U.revision,pivotcam:p,tally:t},function(r){if(r){U.config=r.configuration;U.revision=r.revision;uStatus(r.status);}});
}
</api>

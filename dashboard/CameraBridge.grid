      <param oid="sony_iris" name="Iris (f-number x 100)" type="INT32" value="0" access="0" constrainttype="INT_RANGE" constraint="0;65535;" />
      <param oid="sony_iris_auto" name="Iris: 1 auto / 2 manual" type="INT32" value="1" access="0" constrainttype="INT_RANGE" constraint="1;2;" />
      <param oid="sony_focus_auto" name="Focus: 1 auto / 2 manual" type="INT32" value="1" access="0" constrainttype="INT_RANGE" constraint="1;2;" />
      <param oid="sony_wb_mode" name="White balance: 1 auto / 2 manual" type="INT32" value="1" access="0" constrainttype="INT_RANGE" constraint="1;2;" />
      <param oid="sony_red_gain" name="Red gain (Sony native)" type="INT32" value="-32768" access="0" constrainttype="INT_RANGE" constraint="-32768;65535;" />
      <param oid="sony_blue_gain" name="Blue gain (Sony native)" type="INT32" value="-32768" access="0" constrainttype="INT_RANGE" constraint="-32768;65535;" />
      <param oid="sony_gain" name="Gain dB (Sony native)" type="INT32" value="-32768" access="0" constrainttype="INT_RANGE" constraint="-32768;65535;" />
      <param oid="sony_shutter" name="Shutter speed (Sony native)" type="STRING" value="0" access="0" maxlength="32" />
      <param oid="sony_colour_temperature" name="White balance temperature" type="INT32" value="0" access="0" constrainttype="INT_RANGE" constraint="0;65535;" />
      <param oid="sony_zoom" name="Zoom scale (readback)" type="STRING" value="0" access="0" maxlength="32" />
    </params>
    <timer id="unified_tick" rate="200" autostart="true" />
    <timertask timerid="unified_tick" tasktype="ogscript">uTick();</timertask>
  </meta>
  <label name="CameraBridge" left="16" top="12" width="260" height="44" style="fg#e2e4e9;size:26;txt-align:west;" />
  <button name="Cameras / Setup" left="300" top="10" width="240" height="52" buttontype="push" style="bg#49a8d8;fg#ffffff;bdr:none;size:16;">
    <task tasktype="ogscript">uSetup();</task>
  </button>
  <button name="Control Selected Camera" left="560" top="10" width="320" height="52" buttontype="push" style="bg#494f5b;fg#ffffff;bdr:none;size:16;">
    <task tasktype="ogscript">uControl();</task>
  </button>
  <label name="Starting…" left="900" top="10" width="450" height="52" style="fg#e2e4e9;size:14;txt-align:west;" id="unified_status" />
  <tab left="0" top="72" width="1366" height="800" tabposition="none">
    <abs id="unified_setup" name="Cameras" width="1366" height="800">

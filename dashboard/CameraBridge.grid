      <param oid="setup_bridge_tally_source" name="Allowed tally sender IP" access="1" type="STRING" value="192.168.96.123" widget="3" maxlength="1024" />
      <param oid="setup_bridge_program" name="Program tally bit (Carbonite default: tally 2)" access="1" type="INT32" value="1" constrainttype="INT_CHOICE" widget="7">

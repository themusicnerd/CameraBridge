      <param oid="setup_bridge_bind" name="PIVOTCam listen IP (this bridge host)" access="1" type="STRING" value="127.0.0.1" widget="3" maxlength="1024" />
      <param oid="setup_bridge_controller" name="Allowed Carbonite source IP" access="1" type="STRING" value="192.168.96.123" widget="3" maxlength="1024" />

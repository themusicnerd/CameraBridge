          <abs left="12" top="96" width="408" height="344" style="bg#2c3037;bdr:line;bdr#383d45;">
            <button name="↖" left="8" top="8" width="124" height="104" style="bg#202328;fg#e2e4e9;bdr:line;bdr#383d45;size:22;">
              <ogscript handles="onmousedown">CB_Panasonic.run("jog(-1,1,0,0);",this);</ogscript>

        <constraint key="0">Recall</constraint>
        <constraint key="1">Store</constraint>
      </param>
      <param oid="marshall_shot_number" name="Shot number" type="INT32" value="1" access="1" constrainttype="INT_RANGE" constraint="1;100;" />
      <param oid="marshall_recall_speed" name="Recall Speed" type="INT32" value="15" access="1" constrainttype="INT_RANGE" constraint="1;30;" />
      <param oid="marshall_use_saved_speed" name="Use Saved Speed" type="INT32" value="1" access="1" constrainttype="INT_CHOICE">
        <constraint key="0">Override</constraint>
        <constraint key="1">Saved</constraint>
      </param>
      <param oid="marshall_wb_mode" name="WHITE BALANCE" type="INT32" value="0" access="0" constrainttype="INT_RANGE" constraint="0;3;" />
      <param oid="marshall_red_gain" name="RED GAIN" type="INT32" value="0" access="0" constrainttype="INT_RANGE" constraint="0;255;" />
      <param oid="marshall_blue_gain" name="BLUE GAIN" type="INT32" value="0" access="0" constrainttype="INT_RANGE" constraint="0;255;" />
      <param oid="marshall_exposure_auto" name="EXPOSURE MODE" type="INT32" value="0" access="0" constrainttype="INT_RANGE" constraint="0;1;" />
      <param oid="marshall_brightness" name="BRIGHTNESS" type="INT32" value="0" access="0" constrainttype="INT_RANGE" constraint="0;20;" />
      <param oid="marshall_gain" name="GAIN" type="INT32" value="0" access="0" constrainttype="INT_RANGE" constraint="0;20;" />
      <param oid="marshall_agc_limit" name="AGC LIMIT" type="INT32" value="0" access="0" constrainttype="INT_RANGE" constraint="0;20;" />
      <param oid="marshall_shutter" name="SHUTTER" type="INT32" value="0" access="0" constrainttype="INT_RANGE" constraint="0;15;" />
      <param oid="marshall_black_level" name="BLACK LEVEL" type="INT32" value="0" access="0" constrainttype="INT_RANGE" constraint="0;32;" />
      <param oid="marshall_gamma" name="GAMMA ×10" type="INT32" value="3" access="0" constrainttype="INT_RANGE" constraint="3;8;" />
      <param oid="marshall_colour" name="COLOUR" type="INT32" value="0" access="0" constrainttype="INT_RANGE" constraint="0;20;" />

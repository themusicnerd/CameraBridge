  <tab left="164" top="164" width="1186" height="564" tabposition="none" delay="false" onchange="highlightPage(String(this.getTitleAt(this.getSelectedIndex())));">
    <abs id="page_paint" name="Paint" width="1186" height="564" style="bg#25282e;">
      <abs left="12" top="12" width="276" height="500" style="bg#2c3037;bdr:line;bdr#383d45;">
        <label name="RED GAIN" left="16" top="12" width="244" height="30" style="fg#e2e4e9;size:17;txt-align:west;" />
        <param oid="red_gain" left="16" top="50" width="244" height="48" showlabel="false" widget="6" style="size:18;" />
        <param oid="red_gain" left="32" top="110" width="212" height="278" showlabel="false" widget="26" style="w.nospinner:true;w.labels:false;w.thumbcolor:#49a8d8;w.jumptoclick:false;size:16;" />
        <button name="−" left="16" top="400" width="80" height="52" buttontype="push" style="bg#494f5b;fg#ffffff;bdr:none;size:16;">
          <task tasktype="ogscript">adjust('red_gain',-1,0,255);</task>
        </button>
        <button name="+" left="180" top="400" width="80" height="52" buttontype="push" style="bg#494f5b;fg#ffffff;bdr:none;size:16;">
          <task tasktype="ogscript">adjust('red_gain',1,0,255);</task>
        </button>
        <label name="unknown · never read" left="16" top="462" width="244" height="30" style="fg#a9bbc8;size:12;txt-align:west;" id="actual_red_gain" />
      </abs>
      <abs left="306" top="12" width="276" height="500" style="bg#2c3037;bdr:line;bdr#383d45;">
        <label name="BLUE GAIN" left="16" top="12" width="244" height="30" style="fg#e2e4e9;size:17;txt-align:west;" />
        <param oid="blue_gain" left="16" top="50" width="244" height="48" showlabel="false" widget="6" style="size:18;" />
        <param oid="blue_gain" left="32" top="110" width="212" height="278" showlabel="false" widget="26" style="w.nospinner:true;w.labels:false;w.thumbcolor:#49a8d8;w.jumptoclick:false;size:16;" />
        <button name="−" left="16" top="400" width="80" height="52" buttontype="push" style="bg#494f5b;fg#ffffff;bdr:none;size:16;">
          <task tasktype="ogscript">adjust('blue_gain',-1,0,255);</task>
        </button>
        <button name="+" left="180" top="400" width="80" height="52" buttontype="push" style="bg#494f5b;fg#ffffff;bdr:none;size:16;">
          <task tasktype="ogscript">adjust('blue_gain',1,0,255);</task>
        </button>
        <label name="unknown · never read" left="16" top="462" width="244" height="30" style="fg#a9bbc8;size:12;txt-align:west;" id="actual_blue_gain" />

        </button>
        <param oid="zoom" left="73" top="146" width="74" height="279" showlabel="false" widget="4">
          <ogscript handles="onchange">changed('zoom');</ogscript>
        </param>
        <label name="unknown · never read" left="14" top="488" width="192" height="26" style="fg#a9bbc8;size:11;txt-align:west;" id="actual_zoom" />
      </abs>
      <abs left="970" top="0" width="220" height="560" style="bg#2c3037;bdr:line;bdr#383d45;">
        <label name="FOCUS POSITION" left="14" top="12" width="192" height="28" style="fg#e2e4e9;size:14;txt-align:west;" />
        <param oid="focus" left="14" top="49" width="192" height="32" showlabel="false" widget="6" />

    <reveal id="nav_presets" name="Presets" targetid="page_presets" left="462" top="12" width="104" height="56" style="bg#494f5b;fg#ffffff;bdr:none;size:16;" />
    <reveal id="nav_paint" name="Paint" targetid="page_paint" left="574" top="12" width="104" height="56" style="bg#494f5b;fg#ffffff;bdr:none;size:16;" />
    <reveal id="nav_td1c" name="TouchDrive" targetid="page_td1c" left="686" top="12" width="104" height="56" style="bg#494f5b;fg#ffffff;bdr:none;size:16;" />
    <reveal id="nav_config" name="Config" targetid="page_config" left="798" top="12" width="104" height="56" style="bg#494f5b;fg#ffffff;bdr:none;size:16;" />
    <abs id="bridge_launcher" left="920" top="12" width="180" height="56">
      <help id="open_bridge" left="0" top="0" width="180" height="56" name="Open setup" title="CameraBridge setup" popupwidth="600" popupheight="180" style="bg#49a8d8;fg#ffffff;size:16;">&lt;html&gt;Set the backend URL on Config. Select Open CameraBridge again after feedback loads.&lt;/html&gt;</help>
    </abs>
    <image src="file:///C:/Users/rackpc01/Documents/Codex/2026-10-21/files-pasted-by-the-user-camerabridge/outputs/camerabridge/dashboard/assets/panasonic.png" left="1164" top="15" width="164" height="48" />
  </abs>
  <label name="Camera identification pending" left="164" top="100" width="1178" height="26" style="fg#e2e4e9;size:18;txt-align:west;" id="identity" />
  <label name="Connecting" left="164" top="130" width="1178" height="24" style="fg#a9bbc8;size:14;txt-align:west;" id="connection" />
  <abs left="8" top="104" width="140" height="624" style="bg#2c3037;bdr:line;bdr#383d45;">
    <label name="CAMERAS" left="10" top="10" width="120" height="26" style="fg#e2e4e9;size:14;txt-align:west;" />
    <button name="-" left="8" top="42" width="124" height="54" buttontype="push" style="bg#7433bd;fg#ffffff;bdr:none;size:16;" id="camera_pick_0">
      <task tasktype="ogscript">cameraAt(0);</task>
    </button>
    <button name="-" left="8" top="106" width="124" height="54" buttontype="push" style="bg#494f5b;fg#ffffff;bdr:none;size:16;" id="camera_pick_1">
      <task tasktype="ogscript">cameraAt(1);</task>
    </button>
    <button name="-" left="8" top="170" width="124" height="54" buttontype="push" style="bg#494f5b;fg#ffffff;bdr:none;size:16;" id="camera_pick_2">
      <task tasktype="ogscript">cameraAt(2);</task>
    </button>
    <button name="-" left="8" top="234" width="124" height="54" buttontype="push" style="bg#494f5b;fg#ffffff;bdr:none;size:16;" id="camera_pick_3">
      <task tasktype="ogscript">cameraAt(3);</task>
    </button>
    <button name="-" left="8" top="298" width="124" height="54" buttontype="push" style="bg#494f5b;fg#ffffff;bdr:none;size:16;" id="camera_pick_4">
      <task tasktype="ogscript">cameraAt(4);</task>
